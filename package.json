{
  "name": "@fusionstructure/fstructure",
  "private": false,
  "version": "0.1.1",
  "description": "Aplicación experimental de modelado y análisis estructural 2D de FusionStructure.",
  "type": "module",
  "scripts": {
    "architecture:check": "node scripts/check-local-foundation-dependencies.mjs",
    "architecture:test": "node --test scripts/check-local-foundation-dependencies.test.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "check": "npm run lint && npm run typecheck && npm run architecture:check && npm run architecture:test && npm run test && npm run build",
    "test": "vitest run --maxWorkers=1 --pool=threads --no-file-parallelism"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^1.24.0",
    "motion": "^12.43.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@openai/sites-vite-plugin": "^0.2.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
