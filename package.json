{
  "name": "@fusionstructure/fstructure",
  "private": false,
  "version": "0.1.2",
  "description": "Aplicación experimental de modelado y análisis estructural 2D de FusionStructure.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "verify": "node scripts/verify.mjs",
    "check": "oxlint && tsc -b && npm run architecture:check && npm run architecture:test && vitest run && npm run design:oracle && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "lint:design": "node scripts/lint-design.mjs",
    "architecture:check": "node scripts/check-local-foundation-dependencies.mjs && node scripts/check-single-app-architecture.mjs",
    "architecture:test": "node --test scripts/check-local-foundation-dependencies.test.mjs scripts/check-single-app-architecture.test.mjs",
    "design:oracle": "python3 -m unittest validation/python/test_elements_oracle.py",
    "icons:generate": "node scripts/generate-brand-icons.mjs",
    "scenes:render": "node scripts/render-suite-scenes.mjs",
    "deadcode": "npx -y knip@5"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^1.24.0",
    "motion": "^12.43.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  }
}
